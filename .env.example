# Supabase project settings — copy to `.env` and fill in.
# Both are PUBLIC client keys (safe to commit as placeholders).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend selection. Leave unset to use Supabase. Set to `cloudflare` to use the
# Worker/D1 backend in ./worker (see docs/DEPLOY_CLOUDFLARE.md).
# VITE_BACKEND=cloudflare

# Only needed when the SPA is served from a different origin than the Worker.
# VITE_API_BASE=https://your-worker.example.com
